# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CRON_SECRET=generate_a_long_random_secret

# App URL — used for OAuth redirects (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Google Calendar OAuth (optional — only needed if enabling calendar integration)
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret

# Dev only — enables mock mode for all agents. Server-only (NOT NEXT_PUBLIC) and
# ignored when NODE_ENV=production, so it can never trigger mock data in Vercel.
# MOCK_AGENTS=true

# Set to "false" if you run WITHOUT transactional email (no SMTP configured).
# Hides the non-functional "Forgot password?" flow and warns users at signup that
# their password can't be self-reset (recover via the operator console instead).
# Defaults to enabled. Pair with: turn OFF "Confirm email" in the Supabase dashboard.
# NEXT_PUBLIC_PASSWORD_RESET_ENABLED=false

# ── OPTIONAL: signup CAPTCHA (Cloudflare Turnstile) ──────────────────────────
# Set BOTH to enable CAPTCHA on signup; unset = signup works without CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── OPTIONAL: error monitoring (Sentry) ──────────────────────────────────────
# DSNs capture errors (no-op without them). ORG/PROJECT/AUTH_TOKEN only enable
# build-time source-map upload.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── OPTIONAL: cron heartbeat alerting (Healthchecks.io / Better Stack) ────────
# Each cron pings its URL on success and <url>/fail on failure. Unset = no ping.
CRON_HEARTBEAT_SCHEDULER_URL=
CRON_HEARTBEAT_NUDGE_URL=
CRON_HEARTBEAT_MAINTENANCE_URL=

# ── OPTIONAL but RECOMMENDED: operator console ───────────────────────────────
# Long random secret. Enables GET/POST /api/operator (suspend users, read audit
# log) via the `x-operator-secret` header. Unset = /api/operator returns 404.
OPERATOR_SECRET=

# Production transactional email (Resend) is configured in the SUPABASE DASHBOARD
# (Authentication → Emails → SMTP), not here. See supabase/config.toml.
